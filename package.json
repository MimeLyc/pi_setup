{
  "name": "pi-setup",
  "private": true,
  "version": "0.1.0",
  "description": "Portable configuration templates, extensions, skills, prompts, and themes for the Pi coding agent",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skills",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "scripts": {
    "check": "npm run check:hygiene",
    "check:hygiene": "node ./scripts/check-hygiene.mjs",
    "typecheck": "tsc --noEmit",
    "pack:copy-mode-ime": "node ./scripts/pack-copy-mode-ime.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.0",
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "@types/node": "^22.0.0",
    "typebox": ">=1.0.0",
    "typescript": "^5.8.0"
  }
}
